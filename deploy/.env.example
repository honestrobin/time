# Copy to deploy/.env and adjust. All variables are optional.
HONESTROBIN_BASE_URL=http://localhost:8080
HONESTROBIN_PORT=8080
HONESTROBIN_DB_PASSWORD=change-me
# first_user_only (default) | open | invite_only
HONESTROBIN_SIGNUP_MODE=first_user_only
# Without SMTP nothing is emailed: sign-in links and invitations go to the app log, invoices can't be emailed.
HONESTROBIN_SMTP_HOST=
HONESTROBIN_SMTP_PORT=587
HONESTROBIN_SMTP_USER=
HONESTROBIN_SMTP_PASSWORD=
HONESTROBIN_MAIL_FROM=Honest Robin <no-reply@example.com>
